{
  "name": "@local/figma-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent local Figma read/write bridge for coding agents",
  "license": "UNLICENSED",
  "bin": {
    "figma-bridge": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "skills",
    "schema",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./dist/types/protocol/index.d.ts",
      "default": "./dist/protocol.js"
    },
    "./figma": {
      "types": "./dist/types/figma/index.d.ts",
      "default": "./dist/figma.js"
    },
    "./serialize": {
      "types": "./dist/types/figma/serialize.d.ts",
      "default": "./dist/serialize.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test tests",
    "check": "oxfmt --check .",
    "format": "oxfmt .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "@valibot/to-json-schema": "1.5.0",
    "valibot": "1.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.138.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.41.0",
    "typescript": "6.0.3",
    "ultracite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
